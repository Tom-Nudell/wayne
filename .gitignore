# Generated/large data: bronze/silver/gold layers + episode logs are
# regenerated by the ETL or by orchestrator runs. Only the snapshot
# bundles (in data_root/bundle/) are checked in so smoke tests run out
# of the box.
data_root/bronze/
data_root/silver/
data_root/gold/
data_root/episodes/
data_root/scenarios/
data_root/*.duckdb

# Node
node_modules/
.svelte-kit/
.vercel/
dist/
build/
.wrangler/

# Python bytecode
__pycache__/
*.pyc

# macOS
.DS_Store

# Per-package virtualenvs
*/.venv/
.venv/

# uv lockfiles regenerated locally
uv.lock
.gstack/
data_root/bundle/snapshot_latest/

# Run artifacts (ledger entries are data, not code; episodes from CLI runs).
# **/ so a run started from platform/orchestrator (cwd-relative data_root)
# is caught too, not just one from the repo root.
**/data_root/ledger/
episodes/
